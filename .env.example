# ---------------------------------------------------------------
# Rebuild — environment configuration
# Copy to .env and fill in what you have. Everything has a working
# local default, so an empty .env still boots.
# NEVER commit .env (it is gitignored). This file is the template.
# ---------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated. Vite's default dev server port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File uploads ---
# Where room photos and receipts are written (relative paths resolve from backend/).
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/heic,application/pdf

# --- CREAO Evidence Investigator agent (app-scoped API Trigger) ---
# Two explicit modes. There is NO automatic fallback from live to mock: an
# unconfigured live setup fails loudly (HTTP 503) instead of returning
# simulated evidence.
#   mock → deterministic stub, no network, results badged [SIMULATED]
#   live → real calls to the app-scoped API Trigger
CREAO_MODE=mock

# App ID of the saved, team-owned Rebuild Evidence Investigator.
CREAO_APP_ID=9819d9a5-89e0-4d62-a284-91bac67f8cd1
# App-scoped API Trigger key (capi_…) from the agent detail page in
# agent.creao.ai. Server-side secret: never commit .env, never expose to browser.
CREAO_APP_API_KEY=
# App-scoped host. NOT developer.creao.ai/v1 (that is the CLI product).
CREAO_APP_BASE_URL=https://agent.creao.ai/api/v1

# How room photos and receipts reach the agent. CONFIRMED by Person 2: the
# app-scoped trigger accepts PUBLIC HTTPS URLs in room_photos / receipt_files.
#   unset    → refuse to start a run (default; no wasted credits)
#   url      → short-lived signed URLs served by this backend (real path)
#   demo_url → Person 2's staged GitHub demo files (fixtures/demos only)
#   none     → text only, declared as carrying no evidence
CREAO_EVIDENCE_TRANSPORT=unset

# --- externally reachable evidence URLs ---
# CREAO downloads the files from its own cloud, so this must be an origin it can
# reach: a tunnel (cloudflared/ngrok), a deployed host, or a CDN/bucket in front
# of this API. Loopback/private hosts are rejected automatically.
REBUILD_PUBLIC_BASE_URL=
# HMAC key for evidence links. Empty = random per-process key (links stop working
# after a restart; fine for a dev session).
REBUILD_EVIDENCE_SIGNING_SECRET=
# Link lifetime. Keep it short — receipts must not sit at a permanent address.
REBUILD_EVIDENCE_URL_TTL_SECONDS=900
# Verify every evidence URL answers 200 with an image/pdf content type before a
# run is created. Leave on outside of tests.
CREAO_VERIFY_EVIDENCE_URLS=true
# Tests only: allow http:// and private/loopback hosts.
CREAO_ALLOW_PRIVATE_EVIDENCE_HOSTS=false
# Staged demo evidence (Person 2's files on the agent branch).
CREAO_DEMO_EVIDENCE_BASE_URL=https://raw.githubusercontent.com/anushkaboran/rebuild/agent/demo/

# Run polling.
CREAO_POLL_INTERVAL_SECONDS=3
CREAO_RUN_TIMEOUT_SECONDS=300
CREAO_HTTP_TIMEOUT_SECONDS=60
# Agent contract: at most 10 attached files combined across both file fields.
CREAO_MAX_EVIDENCE_FILES=10

# --- Persistence backend ---
# memory    -> in-process dicts only (tests / throwaway demos)
# spacetime -> SpacetimeDB is authoritative; dicts are a write-through cache
#              hydrated at startup. Explicit: no silent fallback.
STORE_BACKEND=memory
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_DB=rebuild

# --- SpacetimeDB (legacy mirror settings) ---
# Leave disabled until the module in /spacetimedb is published.
SPACETIMEDB_ENABLED=false
SPACETIMEDB_HOST=http://127.0.0.1:3000
SPACETIMEDB_DB=rebuild
SPACETIMEDB_MODULE=rebuild
